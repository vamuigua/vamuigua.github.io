---
import '@fontsource-variable/inter';
import '@fontsource-variable/bricolage-grotesque';
import '@fontsource/silkscreen/400.css';
import '../styles/global.css';
import Hud from '../components/Hud.astro';
import QuickView from '../components/QuickView.astro';
import { profile } from '../data/profile';
import { url } from '../lib/url';

interface Props {
  title?: string;
  description?: string;
  path?: string;
  home?: boolean;
  image?: string;
}

const {
  title,
  description = `${profile.name}: ${profile.role} in Nairobi. Backend systems, enterprise integrations and full-stack products, plus the small games I build for fun.`,
  path = '',
  home = false,
  image = 'og.png',
} = Astro.props;

const fullTitle = title ? `${title} · ${profile.name}` : `${profile.name} · ${profile.role}`;
const canonical = new URL(url(path), Astro.site).href;
const ogImage = new URL(url(image), Astro.site).href;

const person = {
  '@context': 'https://schema.org',
  '@type': 'Person',
  name: profile.name,
  jobTitle: profile.role,
  address: { '@type': 'PostalAddress', addressLocality: 'Nairobi', addressCountry: 'KE' },
  email: `mailto:${profile.email}`,
  url: new URL(url(''), Astro.site).href,
  sameAs: [profile.links.github, profile.links.linkedin, profile.links.x],
  knowsAbout: ['Laravel', 'PHP', 'Vue.js', 'Nuxt', 'REST APIs', 'Redis', 'Kubernetes', 'Flutter', 'Unity'],
};
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1, viewport-fit=cover" />
    <title>{fullTitle}</title>
    <meta name="description" content={description} />
    <meta name="author" content={profile.name} />
    <link rel="canonical" href={canonical} />
    <meta name="theme-color" content="#0a0c19" />
    <link rel="icon" href={url('favicon.svg')} type="image/svg+xml" />
    <link rel="icon" href={url('favicon.png')} type="image/png" sizes="64x64" />
    <link rel="apple-touch-icon" href={url('apple-touch-icon.png')} />

    <meta property="og:type" content="website" />
    <meta property="og:title" content={fullTitle} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonical} />
    <meta property="og:image" content={ogImage} />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:creator" content="@VictorAllen22" />

    {home && <script type="application/ld+json" set:html={JSON.stringify(person)} />}

    <script is:inline>
      document.documentElement.classList.add('js');
    </script>
  </head>
  <body>
    <a class="skip-link" href="#main">Skip to content</a>
    <Hud home={home} />
    <main id="main" tabindex="-1">
      <slot />
    </main>
    <slot name="footer" />
    <QuickView />
    <div class="toasts" id="toasts" role="status" aria-live="polite"></div>
    <script>
      import '../scripts/app.ts';
    </script>
  </body>
</html>
