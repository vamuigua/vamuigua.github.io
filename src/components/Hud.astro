---
import Icon from './Icon.astro';
import { url } from '../lib/url';
import { profile } from '../data/profile';

interface Props {
  home?: boolean;
}
const { home = false } = Astro.props;

const prefix = home ? '' : url('');
const nav = [
  { id: 'profile', label: 'About', key: 'Profile' },
  { id: 'journey', label: 'Experience', key: 'Journey' },
  { id: 'missions', label: 'Projects', key: 'Missions' },
  { id: 'skills', label: 'Skills', key: 'Skill tree' },
  { id: 'achievements', label: 'Milestones', key: 'Achievements' },
  { id: 'contact', label: 'Contact', key: 'Save point' },
];
---

<header class="hud" data-hud>
  <div class="hud__inner">
    <a class="hud__brand" href={home ? '#top' : url('')}>
      <span class="hud__emblem" aria-hidden="true">
        <svg viewBox="0 0 10 10" shape-rendering="crispEdges">
          <rect x="0" y="0" width="10" height="10" fill="#141832"></rect>
          <path d="M1 2h1v1H1zM2 3h1v2H2zM3 5h1v2H3zM4 7h2v1H4zM6 5h1v2H6zM7 3h1v2H7zM8 2h1v1H8z" fill="#ffb547"></path>
          <rect x="4" y="2" width="2" height="1" fill="#5ee6b0"></rect>
        </svg>
      </span>
      <span class="hud__name">
        <span class="hud__name-full">Victor Allen Muigua</span>
        <span class="hud__lvl pixel">Senior Engineer</span>
      </span>
    </a>

    <nav class="hud__nav" aria-label="Sections">
      <ul>
        {
          nav.map((n) => (
            <li>
              <a href={`${prefix}#${n.id}`} data-nav={n.id} title={n.key}>
                {n.label}
              </a>
            </li>
          ))
        }
      </ul>
    </nav>

    <div class="hud__actions">
      <button class="icon-btn" type="button" data-sound-toggle aria-pressed="false" aria-label="Sound effects">
        <span class="when-off"><Icon name="volume-x" /></span>
        <span class="when-on"><Icon name="volume-2" /></span>
      </button>
      <button class="btn btn--ghost btn--sm hud__quick" type="button" data-quickview-open aria-haspopup="dialog">
        <Icon name="zap" /> <span>Quick view</span><kbd class="kbd" aria-hidden="true">Q</kbd>
      </button>
      <a class="btn btn--primary btn--sm hud__cv" href={url(profile.cv)} download>
        <Icon name="download" /> <span>CV</span>
      </a>
      <button
        class="icon-btn hud__menu-btn"
        type="button"
        data-menu-open
        aria-expanded="false"
        aria-controls="pause-menu"
        aria-label="Open menu"
      >
        <Icon name="menu" />
      </button>
    </div>
  </div>
  <div class="xp" aria-hidden="true">
    <span class="xp__label pixel">EXP</span>
    <span class="xp__track"><span class="xp__fill" data-xp></span></span>
  </div>
</header>

<!-- Mobile "pause menu" -->
<div class="pause" id="pause-menu" data-menu hidden>
  <div class="pause__backdrop" data-menu-close></div>
  <div class="pause__panel pixel-frame" role="dialog" aria-modal="true" aria-labelledby="pause-title">
    <div class="pause__head">
      <p id="pause-title" class="pixel pause__title">Paused · Menu</p>
      <button class="icon-btn" type="button" data-menu-close aria-label="Close menu"><Icon name="x" /></button>
    </div>
    <ul class="pause__list">
      {
        nav.map((n, i) => (
          <li>
            <a href={`${prefix}#${n.id}`} data-menu-link>
              <span class="pixel pause__num">0{i + 1}</span>
              <span class="pause__label">{n.label}</span>
              <span class="pause__key">{n.key}</span>
            </a>
          </li>
        ))
      }
    </ul>
    <div class="pause__foot">
      <button class="btn btn--sm" type="button" data-quickview-open><Icon name="zap" /> Quick view</button>
      <a class="btn btn--primary btn--sm" href={url(profile.cv)} download><Icon name="download" /> Download CV</a>
    </div>
  </div>
</div>

<style>
  .hud {
    position: fixed;
    inset: 0 0 auto 0;
    z-index: 100;
    height: var(--hud-h);
    transition:
      background-color var(--t-med) var(--ease-out),
      border-color var(--t-med) var(--ease-out);
    border-bottom: 1px solid transparent;
  }

  :global(.hud-solid) .hud,
  .hud.is-solid {
    background: rgb(10 12 25 / 0.78);
    -webkit-backdrop-filter: blur(14px) saturate(140%);
    backdrop-filter: blur(14px) saturate(140%);
    border-bottom-color: var(--line);
  }

  .hud__inner {
    height: 100%;
    max-width: 1320px;
    margin-inline: auto;
    padding-inline: var(--gutter);
    display: flex;
    align-items: center;
    gap: var(--s-4);
  }

  .hud__brand {
    display: flex;
    align-items: center;
    gap: 10px;
    text-decoration: none;
    min-width: 0;
  }

  .hud__emblem svg {
    width: 34px;
    height: 34px;
    image-rendering: pixelated;
    border: 1px solid var(--line-strong);
  }

  .hud__name {
    display: grid;
    line-height: 1.15;
  }

  .hud__name-full {
    font-family: var(--font-display);
    font-weight: 700;
    font-size: 0.98rem;
    letter-spacing: -0.01em;
    white-space: nowrap;
  }

  .hud__lvl {
    font-size: 0.6rem;
    color: var(--jade);
    text-transform: uppercase;
  }

  .hud__nav {
    margin-left: auto;
  }

  .hud__nav ul {
    display: flex;
    gap: 2px;
    list-style: none;
  }

  .hud__nav a {
    position: relative;
    display: block;
    padding: 8px 12px;
    border-radius: var(--r-sm);
    font-size: 0.9rem;
    font-weight: 500;
    color: var(--text-muted);
    text-decoration: none;
    transition: color var(--t-fast), background-color var(--t-fast);
  }

  .hud__nav a:hover {
    color: var(--text);
    background: rgb(255 255 255 / 0.04);
  }

  .hud__nav a[aria-current='true'] {
    color: var(--text);
  }

  .hud__nav a[aria-current='true']::before {
    content: '';
    position: absolute;
    left: 50%;
    bottom: 2px;
    width: 6px;
    height: 6px;
    translate: -50% 0;
    background: var(--ember);
    box-shadow: 0 0 10px var(--ember);
  }

  .hud__actions {
    display: flex;
    align-items: center;
    gap: 8px;
  }

  .kbd {
    font-family: var(--font-pixel);
    font-size: 0.6rem;
    padding: 2px 5px;
    border: 1px solid var(--line-strong);
    border-radius: 4px;
    color: var(--text-dim);
  }

  [data-sound-toggle] .when-on {
    display: none;
  }

  [data-sound-toggle][aria-pressed='true'] .when-on {
    display: inline-grid;
    color: var(--jade);
  }

  [data-sound-toggle][aria-pressed='true'] .when-off {
    display: none;
  }

  .hud__menu-btn {
    display: none;
  }

  /* EXP bar = reading progress */
  .xp {
    position: absolute;
    left: 0;
    right: 0;
    bottom: -1px;
    height: 3px;
    display: flex;
    align-items: center;
    pointer-events: none;
  }

  .xp__label {
    display: none;
  }

  .xp__track {
    flex: 1;
    height: 100%;
    background: transparent;
  }

  .xp__fill {
    display: block;
    height: 100%;
    width: 100%;
    transform-origin: 0 50%;
    transform: scaleX(var(--xp, 0));
    background: linear-gradient(90deg, var(--jade), var(--ember));
    box-shadow: 0 0 10px rgb(94 230 176 / 0.5);
  }

  @media (max-width: 1100px) {
    .hud__nav a {
      padding-inline: 9px;
      font-size: 0.85rem;
    }

    .hud__quick .kbd {
      display: none;
    }
  }

  @media (max-width: 960px) {
    .hud__nav,
    .hud__quick,
    [data-sound-toggle] {
      display: none;
    }

    .hud__actions {
      margin-left: auto;
    }

    .hud__menu-btn {
      display: inline-grid;
    }
  }

  @media (max-width: 380px) {
    .hud__name-full {
      font-size: 0.88rem;
    }
  }

  /* Pause menu */
  .pause {
    position: fixed;
    inset: 0;
    z-index: 120;
    display: grid;
    align-items: start;
    justify-items: end;
    padding: calc(var(--hud-h) - 8px) 12px 12px;
  }

  .pause[hidden] {
    display: none;
  }

  .pause__backdrop {
    position: absolute;
    inset: 0;
    background: rgb(6 7 14 / 0.6);
    -webkit-backdrop-filter: blur(4px);
    backdrop-filter: blur(4px);
    animation: fade 200ms var(--ease-out);
  }

  .pause__panel {
    position: relative;
    width: min(380px, 100%);
    padding: 16px;
    background: var(--glass-strong);
    border: 1px solid var(--line-strong);
    box-shadow: var(--shadow-2);
    animation: drop 260ms var(--ease-out);
  }

  .pause__head {
    display: flex;
    align-items: center;
    justify-content: space-between;
    margin-bottom: 8px;
  }

  .pause__title {
    font-size: 0.72rem;
    color: var(--ember);
    text-transform: uppercase;
  }

  .pause__list {
    list-style: none;
    display: grid;
    gap: 2px;
  }

  .pause__list a {
    display: grid;
    grid-template-columns: 32px 1fr auto;
    align-items: center;
    gap: 8px;
    padding: 12px 10px;
    border-radius: var(--r-sm);
    text-decoration: none;
  }

  .pause__list a:hover,
  .pause__list a:focus-visible {
    background: rgb(255 255 255 / 0.05);
  }

  .pause__num {
    font-size: 0.7rem;
    color: var(--text-dim);
  }

  .pause__label {
    font-weight: 600;
  }

  .pause__key {
    font-size: 0.78rem;
    color: var(--text-dim);
  }

  .pause__foot {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 8px;
    margin-top: 12px;
    padding-top: 12px;
    border-top: 1px solid var(--line);
  }

  @keyframes fade {
    from {
      opacity: 0;
    }
  }

  @keyframes drop {
    from {
      opacity: 0;
      transform: translateY(-8px);
    }
  }
</style>
