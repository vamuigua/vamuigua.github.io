---
import { iconSvg } from '../lib/icons';

interface Props {
  name: string;
  class?: string;
  size?: number;
}

const { name, class: className, size } = Astro.props;
const svg = iconSvg(name);
const style = size ? `width:${size}px;height:${size}px` : undefined;
---

<span class:list={['icon', className]} style={style} set:html={svg} />

<style>
  .icon {
    display: inline-grid;
    place-items: center;
    flex: none;
    width: 1.15em;
    height: 1.15em;
  }

  .icon :global(svg) {
    width: 100%;
    height: 100%;
  }
</style>
